# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real credentials.

# The Gmail address that will SEND mail on the form's behalf.
GMAIL_USER=your-sending-address@gmail.com

# A Gmail "App Password" — NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account).
# It's a 16-character code like: abcd efgh ijkl mnop — paste it with no spaces.
GMAIL_APP_PASSWORD=your16characterapppassword

# Optional: where form submissions land, if different from GMAIL_USER.
CONTACT_TO_EMAIL=your-inbox@example.com

# Public contact details shown on the site. These are intentionally public and
# visible in page source, so keep different values only if you want the public
# display data to differ from your private contact info.
NEXT_PUBLIC_CONTACT_PHONE=+923000000000
NEXT_PUBLIC_CONTACT_WHATSAPP=+923000000000

# The public address of the deployed site, used for link previews. Example: https://yourname.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
